DATABASE_URL="postgresql://postgres:postgres@localhost:5432/college_visitor?schema=public"

PORT=4000
CORS_ORIGIN="http://localhost:3000"

# S3-compatible storage for admin-uploaded college media (S3, Cloudflare R2, etc.)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

GOOGLE_APPS_SCRIPT_URL=
ADMIN_EMAIL=

RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=viscolproject@gmail.com

# ------------------------------------------------------
# Disabled SMTP configuration.
# Reason:
# Hosted environments (Render/Koyeb/etc.) can experience
# SMTP timeout issues.
# Kept for future rollback.
# Using Resend API instead.
# ------------------------------------------------------
# SMTP_HOST=
# SMTP_PORT=
# SMTP_SECURE=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
